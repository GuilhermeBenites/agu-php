<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" cacheResultFile="var/.phpunit.result.cache">
    <php>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="APP_DEBUG" value="1"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>

    </php>
    <testsuites>
        <testsuite name="Application"><directory>tests</directory></testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include><directory suffix=".php">src</directory></include>
    </coverage>
</phpunit>
