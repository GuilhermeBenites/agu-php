{
  "name": "agu/tasks-api",
  "description": "API de tarefas da prova técnica AGU.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-redis": "^6.1",
    "doctrine/dbal": "^3.8",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.2",
    "lexik/jwt-authentication-bundle": "^2.21",
    "nelmio/cors-bundle": "^2.5",
    "symfony/cache": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/flex": "^2.4",
    "symfony/framework-bundle": "6.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/runtime": "6.4.*",
    "symfony/security-bundle": "6.4.*",
    "symfony/serializer": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/yaml": "6.4.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^9.6",
    "symfony/browser-kit": "6.4.*",
    "symfony/css-selector": "6.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "lint": [
      "@php bin/console lint:yaml config",
      "@php bin/console lint:container",
      "@php bin/console doctrine:schema:validate"
    ],
    "analyse": "@php vendor/bin/phpstan analyse --no-progress",
    "format:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "format": "@php vendor/bin/php-cs-fixer fix",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@analyse",
      "@format:check"
    ],
    "test:prepare": "@php tests/prepare-database.php",
    "test": [
      "@test:prepare",
      "@php vendor/bin/phpunit"
    ],
    "test:coverage": [
      "@test:prepare",
      "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-clover var/coverage/clover.xml --coverage-html var/coverage/html"
    ]
  }
}
